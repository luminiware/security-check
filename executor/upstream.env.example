# Research configuration only; not a validated or production-approved artifact.
API_ENABLED_CHECKS=headers,http-security,ssl,dns
# The inspected upstream exempts get-ip from API_ENABLED_CHECKS.
# An explicit deny is required in addition to our own route allowlist.
API_DISABLED_CHECKS=get-ip
DISABLE_GUI=true
# No token, HubSpot credential or control-plane address belongs in this process.
