{
  "name": "luminiware-security-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev --local --ip 127.0.0.1",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply security-check --local",
    "metrics:local": "node scripts/wrangler.mjs d1 execute security-check --local --file scripts/metrics.sql",
    "build": "node scripts/wrangler.mjs deploy --dry-run --outdir dist",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:ui": "playwright test",
    "test:upstream": "node scripts/test-upstream.mjs",
    "test:egress": "node scripts/test-egress.mjs",
    "test:runner": "node scripts/test-runner.mjs",
    "test:resolver": "node scripts/test-resolver.mjs",
    "test:http": "node scripts/test-http.mjs",
    "test:ipv6": "node scripts/test-ipv6.mjs",
    "test:ipv6:routed": "node scripts/test-ipv6-routed.mjs",
    "check": "node scripts/check.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "executor": "node executor/supervisor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "miniflare": "5.20261104.0-beta",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "tldts": "7.4.19"
  }
}
