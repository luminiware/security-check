{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luminiware-security-check",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "security-check",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "queues": { "producers": [{ "binding": "JOBS", "queue": "security-check-jobs" }] },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true }, "logs": { "invocation_logs": false } },
  "vars": { "DEMO": "true", "PUBLIC_ADMISSION": "false", "LEADS_ENABLED": "false", "QUICK_CHECK_ENABLED": "false", "QUICK_EGRESS_REVIEWED": "false" }
}
